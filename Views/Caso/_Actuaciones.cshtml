@model IReadOnlyList<e_violenciagen.ViewModels.Casos.CasoActuacionViewModel>

<div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3
                d-flex justify-content-between
                align-items-center">

        <div>
            <h5 class="mb-0 fw-semibold">
                Línea temporal de actuaciones
            </h5>
        </div>

        <button type="button"
                class="btn btn-primary btn-sm">
            Nueva actuación
        </button>

    </div>


    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                No existen actuaciones registradas.
            </div>
        }
        else
        {
            <div class="position-relative">

                @foreach (var actuacion in Model)
                {
                    <div class="d-flex gap-3 mb-4">

                        <div>
                            <div class="rounded-circle
                                        bg-primary
                                        flex-shrink-0"
                                 style="width:12px;
                                        height:12px;
                                        margin-top:7px;">
                            </div>
                        </div>

                        <div class="flex-grow-1">

                            <div class="card border">

                                <div class="card-body">

                                    <div class="d-flex
                                                flex-column
                                                flex-md-row
                                                justify-content-between
                                                gap-2 mb-2">

                                        <div>

                                            <h6 class="fw-bold mb-1">
                                                @actuacion.Titulo
                                            </h6>

                                            <div class="small text-muted">

                                                @actuacion.Institucion

                                                @if (!string.IsNullOrWhiteSpace(
                                                    actuacion.UnidadOrganizativa))
                                                {
                                                    <span>
                                                        · @actuacion.UnidadOrganizativa
                                                    </span>
                                                }

                                            </div>

                                        </div>

                                        <div class="text-muted small">
                                            @actuacion.FechaActuacion
                                                .ToLocalTime()
                                                .ToString("dd/MM/yyyy HH:mm")
                                        </div>

                                    </div>


                                    <span class="badge
                                                 bg-primary-subtle
                                                 text-primary mb-3">
                                        @actuacion.TipoActuacion
                                    </span>


                                    @if (!string.IsNullOrWhiteSpace(
                                        actuacion.Descripcion))
                                    {
                                        <p class="mb-3">
                                            @actuacion.Descripcion
                                        </p>
                                    }


                                    <div class="small text-muted">

                                        <span class="me-3">
                                            Participantes:
                                            @actuacion.NumeroParticipantes
                                        </span>

                                        <span>
                                            Documentos:
                                            @actuacion.NumeroDocumentos
                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>