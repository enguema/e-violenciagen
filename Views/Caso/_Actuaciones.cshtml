@model IReadOnlyList<e_violenciagen.ViewModels.Casos.CasoActuacionViewModel>

<div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3
        d-flex justify-content-between
        align-items-center">

        <div>
            <h5 class="mb-0 fw-semibold">
                Línea temporal de actuaciones
            </h5>
        </div>

        @*<button type="button" class="btn btn-primary btn-sm">
            Nueva actuación
        </button>*@
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal"
                data-bs-target="#modalRegistrarActuacion">

            Nueva actuación

        </button>

    </div>


    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                No existen actuaciones registradas.
            </div>
        }
        else
        {
            <div class="position-relative">

                @foreach (var actuacion in Model)
                {
                    <div class="d-flex gap-3 mb-4">

                        <div>
                            <div class="rounded-circle
                                bg-primary
                                flex-shrink-0" style="width:12px;
                                height:12px;
                                margin-top:7px;">
                            </div>
                        </div>

                        <div class="flex-grow-1">

                            <div class="card border">

                                <div class="card-body">

                                    <div class="d-flex
                                        flex-column
                                        flex-md-row
                                        justify-content-between
                                        gap-2 mb-2">

                                        <div>

                                            <h6 class="fw-bold mb-1">
                                                @actuacion.Titulo
                                            </h6>

                                            <div class="small text-muted">

                                                @actuacion.Institucion

                                                @if (!string.IsNullOrWhiteSpace(
                                                    actuacion.UnidadOrganizativa))
                                                {
                                                    <span>
                                                        · @actuacion.UnidadOrganizativa
                                                    </span>
                                                }

                                            </div>

                                        </div>

                                        <div class="text-muted small">
                                            @actuacion.FechaActuacion
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy HH:mm")
                                        </div>

                                    </div>


                                    <span class="badge
                                        bg-primary-subtle
                                        text-primary mb-3">
                                        @actuacion.TipoActuacion
                                    </span>


                                    @if (!string.IsNullOrWhiteSpace(
                                        actuacion.Descripcion))
                                    {
                                        <p class="mb-3">
                                            @actuacion.Descripcion
                                        </p>
                                    }

                                    @*AGREGAR PARTICIPANTES*@
                                    <div class="mt-3">

                                        <div class="d-flex
                                            justify-content-between
                                            align-items-center
                                            mb-2">

                                            <strong>Participantes</strong>

                                            <button type="button"
                                                    class="btn btn-outline-primary btn-sm btn-agregar-participante"
                                                    data-bs-toggle="modal" data-bs-target="#modalAgregarParticipante"
                                                    data-actuacion-id="@actuacion.Id" data-actuacion-titulo="@actuacion.Titulo">

                                                Agregar participante

                                            </button>

                                        </div>

                                        @if (actuacion.Participantes.Any())
                                        {
                                            <div class="list-group">

                                                @foreach (var participante in actuacion.Participantes)
                                                {
                                                    <div class="list-group-item
                                                        d-flex
                                                        justify-content-between
                                                        align-items-center">

                                                        <div>

                                                            <strong>
                                                                @participante.NombreCompleto
                                                            </strong>

                                                            @if (!string.IsNullOrWhiteSpace(
                                                                participante.UnidadOrganizativa))
                                                            {
                                                                <div class="small text-muted">
                                                                    @participante.UnidadOrganizativa
                                                                </div>
                                                            }

                                                        </div>

                                                        <button type="button" class="btn btn-outline-danger btn-sm"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#quitarParticipante_@actuacion.Id@participante.UsuarioId">

                                                            Quitar

                                                        </button>

                                                    </div>
                                                    @*MODAL - QUITAR PARTICIPANTE*@
                                                    <div class="modal fade" id="quitarParticipante_@actuacion.Id@participante.UsuarioId"
                                                         tabindex="-1" aria-hidden="true">

                                                        <div class="modal-dialog modal-dialog-centered">

                                                            <div class="modal-content">

                                                                <form asp-controller="Caso" asp-action="QuitarParticipanteActuacion"
                                                                      method="post">

                                                                    @Html.AntiForgeryToken()

                                                                    <input type="hidden" name="CasoId" value="@participante.CasoId" />

                                                                    <input type="hidden" name="ActuacionId" value="@actuacion.Id" />

                                                                    <input type="hidden" name="UsuarioId"
                                                                           value="@participante.UsuarioId" />

                                                                    <div class="modal-header">

                                                                        <h5 class="modal-title">
                                                                            Quitar participante
                                                                        </h5>

                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal">
                                                                        </button>

                                                                    </div>

                                                                    <div class="modal-body">

                                                                        <p>
                                                                            ¿Desea quitar a
                                                                            <strong>
                                                                                @participante.NombreCompleto
                                                                            </strong>
                                                                            de esta actuación?
                                                                        </p>

                                                                        <div class="alert alert-warning mb-0">
                                                                            El usuario no será eliminado del sistema.
                                                                            Solo se eliminará su participación en esta actuación.
                                                                        </div>

                                                                    </div>

                                                                    <div class="modal-footer">

                                                                        <button type="button" class="btn btn-secondary"
                                                                                data-bs-dismiss="modal">
                                                                            Cancelar
                                                                        </button>

                                                                        <button type="submit" class="btn btn-danger">
                                                                            Sí, quitar
                                                                        </button>

                                                                    </div>

                                                                </form>

                                                            </div>

                                                        </div>

                                                    </div>
                                                    @*FIN - MODAL PARTICIPANTE*@
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted small">
                                                No hay participantes registrados.
                                            </div>
                                        }

                                    </div>
                                    
                                    @*FIN - AGREGAR PARTICIPANTES*@

                                    <div class="small text-muted">

                                        <span class="me-3">
                                            Participantes:
                                            @actuacion.NumeroParticipantes
                                        </span>

                                        <span>
                                            Documentos:
                                            @actuacion.NumeroDocumentos
                                        </span>

                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        actuacion.Resultado))
                                    {
                                        <div class="mt-2">
                                            <strong>Resultado:</strong>
                                            @actuacion.Resultado
                                        </div>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>
