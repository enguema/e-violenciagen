@using Microsoft.AspNetCore.Authorization
@using e_violenciagen.ViewModels.Personas
@inject IAuthorizationService AuthorizationService
@model e_violenciagen.ViewModels.Casos.CasoDetailsViewModel

@{
    ViewData["Title"] = $"Expediente {Model.CodigoCaso}";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">

        @TempData["Success"]

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">

        @TempData["Error"]

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar">
        </button>

    </div>
}

@{
    var puedeEditar =
        await AuthorizationService.AuthorizeAsync(
            User,
            PermisosSistema.Casos.Editar);

    var puedeCerrar =
        await AuthorizationService.AuthorizeAsync(
            User,
            PermisosSistema.Casos.Cerrar);

    var puedeCrearActuacion =
        await AuthorizationService.AuthorizeAsync(
            User,
            PermisosSistema.Actuaciones.Crear);

    var puedeSubirDocumento =
        await AuthorizationService.AuthorizeAsync(
            User,
            PermisosSistema.Documentos.Subir);
}

<div class="container-fluid py-4">

    <!-- =====================================================
         CABECERA DEL EXPEDIENTE
         ===================================================== -->
    <div class="card border-0 shadow-sm mb-4 overflow-hidden">

        <div class="card-body p-4">

            <div class="d-flex flex-column flex-lg-row
                justify-content-between
                align-items-lg-start
                gap-3">

                <div>

                    <div class="text-uppercase text-muted
                        small fw-semibold mb-2">
                        Expediente electrónico
                    </div>

                    <h1 class="h2 fw-bold mb-2">
                        @Model.CodigoCaso
                    </h1>

                    <div class="d-flex flex-wrap gap-2">

                        <span class="badge rounded-pill
                            bg-primary-subtle
                            text-primary px-3 py-2">
                            @Model.Estado
                        </span>

                        <span class="badge rounded-pill
                            bg-light text-dark
                            px-3 py-2">

                            Registrado:
                            @Model.FechaRegistro
                            .ToLocalTime()
                            .ToString("dd/MM/yyyy")
                        </span>

                    </div>

                </div>

                <div class="d-flex gap-2">

                    <a asp-action="Index" class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-1"></i>
                        Volver
                    </a>

                    @if (puedeEditar.Succeeded)
                    {
                        <button class="btn btn-primary">
                            <i class="bi bi-pencil-square me-1"></i>
                            Editar
                        </button>
                    }

                </div>

            </div>

        </div>
    </div>


    <!-- =====================================================
         INDICADORES
         ===================================================== -->

    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Víctimas
                    </div>

                    <div class="h2 fw-bold mb-0">
                        @Model.Victimas.Count
                    </div>

                </div>
            </div>
        </div>


        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Presuntos agresores
                    </div>

                    <div class="h2 fw-bold mb-0">
                        @Model.PresuntosAgresores.Count
                    </div>

                </div>
            </div>
        </div>


        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Actuaciones
                    </div>

                    <div class="h2 fw-bold mb-0">
                        @Model.Actuaciones.Count
                    </div>

                </div>
            </div>
        </div>


        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Documentos
                    </div>

                    <div class="h2 fw-bold mb-0">
                        @Model.Documentos.Count
                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- =====================================================
         NAVEGACIÓN DEL EXPEDIENTE
         ===================================================== -->

    <ul class="nav nav-pills mb-4 gap-2" id="expedienteTabs" role="tablist">

        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#resumen">
                Resumen
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#personas">
                Personas
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#actuaciones">
                Actuaciones
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#documentos">
                Documentos
            </button>
        </li>

    </ul>


    <!-- =====================================================
         CONTENIDO
         ===================================================== -->

    <div class="tab-content">

        <div class="tab-pane fade show active" id="resumen">

            <partial name="_Resumen" model="Model" />

        </div>


        <div class="tab-pane fade" id="personas">

            <partial name="_Personas" model="Model" />

        </div>


        <div class="tab-pane fade" id="actuaciones">

            <div id="actuacionesContainer">

                <partial name="_Actuaciones" model="Model.Actuaciones" />

                <div class="card shadow-sm mb-4">

                    <div class="card-header d-flex
                        justify-content-between
                        align-items-center">

                        <div>
                            <h5 class="mb-0">
                                Actuaciones institucionales
                            </h5>

                            <small class="text-muted">
                                Intervenciones realizadas por las instituciones
                                participantes en el expediente.
                            </small>
                        </div>

                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal"
                                data-bs-target="#modalRegistrarActuacion">

                            Registrar actuación

                        </button>

                    </div>

                    <div class="card-body">

                        @if (Model.Actuaciones != null &&
                             Model.Actuaciones.Any())
                        {
                            foreach (var actuacion in Model.Actuaciones)
                            {
                                <div class="border rounded p-3 mb-3">

                                    <div class="d-flex
                                        justify-content-between
                                        align-items-start">

                                        <div>
                                            <strong>
                                                @actuacion.Titulo
                                            </strong>

                                            <div class="text-muted small">
                                                @actuacion.TipoActuacion
                                            </div>
                                        </div>

                                        <span class="badge text-bg-light">
                                            @actuacion.FechaActuacion
                                        </span>

                                    </div>

                                    <div class="mt-2">
                                        <strong>Institución:</strong>
                                        @actuacion.Institucion
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        actuacion.UnidadOrganizativa))
                                    {
                                        <div>
                                            <strong>Unidad:</strong>
                                            @actuacion.UnidadOrganizativa
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(
                                        actuacion.Descripcion))
                                    {
                                        <p class="mt-2 mb-1">
                                            @actuacion.Descripcion
                                        </p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(
                                        actuacion.Resultado))
                                    {
                                        <div class="mt-2">
                                            <strong>Resultado:</strong>
                                            @actuacion.Resultado
                                        </div>
                                    }

                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted text-center py-4">

                                Todavía no se han registrado actuaciones
                                institucionales en este expediente.

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>


        <div class="tab-pane fade" id="documentos">

            <div id="documentosContainer">

                <partial name="_Documentos" model="Model.Documentos" />

            </div>

        </div>

    </div>

</div>

<!-- =====================================================
     MODAL: AGREGAR VÍCTIMA
     ===================================================== -->

<div class="modal fade" id="modalAgregarVictima" tabindex="-1" aria-labelledby="modalAgregarVictimaLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <form asp-controller="Caso" asp-action="AgregarVictima" method="post">

                @Html.AntiForgeryToken()

                <!-- Identificador del expediente -->
                <input type="hidden" name="CasoId" value="@Model.Id" />

                <div class="modal-header">

                    <h5 class="modal-title" id="modalAgregarVictimaLabel">

                        Agregar víctima al expediente

                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="alert alert-light border mb-3">

                        Busque y seleccione una persona
                        previamente registrada en el sistema.

                    </div>

                    @await Html.PartialAsync(
                        "_PersonaSelector",
                        new PersonaSelectorViewModel
                        {
                            Label = "Víctima",
                            FieldName = "PersonaId",
                            SelectedPersonaId = null
                        })

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit" class="btn btn-primary">

                        Agregar víctimaaa

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- =====================================================
     MODAL: AGREGAR PRESUNTO AGRESOR
     ===================================================== -->

