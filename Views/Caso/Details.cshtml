</div>

<!-- =====================================================
     MODAL: REGISTRAR ACTUACIÓN
     ===================================================== -->
<div class="modal fade" id="modalRegistrarActuacion" tabindex="-1" aria-labelledby="modalRegistrarActuacionLabel"
     aria-hidden="true">

    <div class="modal-dialog
        modal-lg
        modal-dialog-centered
        modal-dialog-scrollable">

        <div class="modal-content">

            <form asp-controller="Caso" asp-action="RegistrarActuacion" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="CasoId" value="@Model.Id" />

                <div class="modal-header">

                    <h5 class="modal-title" id="modalRegistrarActuacionLabel">

                        Registrar actuación institucional

                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="row g-3">

                        <!-- Tipo de actuación -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Tipo de actuación
                            </label>

                            <select name="TipoActuacionId" class="form-select" required>

                                <option value="">
                                    Seleccione...
                                </option>

                                @foreach (
                                    var tipo in Model.TiposActuacion)
                                {
                                    <option value="@tipo.Id">
                                        @tipo.Nombre
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- Fecha -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Fecha y hora
                            </label>

                            <input type="datetime-local" name="FechaActuacion" class="form-control" required />

                        </div>


                        <!-- Institución -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Institución
                            </label>

                            <select id="institucionActuacion" name="InstitucionId" class="form-select" required>

                                <option value="">
                                    Seleccione...
                                </option>

                                @foreach (var institucion in Model.Instituciones)
                                {
                                    <option value="@institucion.Id">
                                        @institucion.Nombre
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- Unidad -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Unidad organizativa
                            </label>

                            <select id="unidadActuacion" name="UnidadOrganizativaId" class="form-select" disabled>

                                <option value="">
                                    Seleccione primero una institución
                                </option>

                            </select>

                            <div class="form-text">
                                Opcional.
                            </div>

                        </div>


                        <!-- Título -->
                        <div class="col-12">

                            <label class="form-label">
                                Título
                            </label>

                            <input type="text" name="Titulo" class="form-control" maxlength="200" required />

                        </div>


                        <!-- Descripción -->
                        <div class="col-12">

                            <label class="form-label">
                                Descripción
                            </label>

                            <textarea name="Descripcion" class="form-control" rows="4" maxlength="4000">
                            </textarea>

                        </div>


                        <!-- Resultado -->
                        <div class="col-12">

                            <label class="form-label">
                                Resultado
                            </label>

                            <textarea name="Resultado" class="form-control" rows="3" maxlength="2000">
                            </textarea>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit" class="btn btn-primary">

                        Registrar actuación

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@*Modal para agregar participante*@
<div class="modal fade"
     id="modalAgregarParticipante"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form asp-controller="Caso"
                  asp-action="AgregarParticipanteActuacion"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="CasoId"
                       value="@Model.Id" />

                <input type="hidden"
                       id="participanteActuacionId"
                       name="ActuacionId" />

                <div class="modal-header">

                    <div>
                        <h5 class="modal-title">
                            Agregar participante
                        </h5>

                        <small class="text-muted"
                               id="participanteActuacionTitulo">
                        </small>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <label class="form-label">
                        Profesional institucional
                    </label>

                    <select id="participanteUsuarioId"
                            name="UsuarioId"
                            class="form-select"
                            required
                            disabled>

                        <option value="">
                            Seleccione una actuación
                        </option>

                    </select>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        Agregar

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



@section Styles {
    <link rel="stylesheet" href="~/css/casos.css" asp-append-version="true" />
}

@section Scripts {

    <script>
        window.sigevigCasoId = "@Model.Id";
    </script>

    <script src="~/js/casos/details.js" asp-append-version="true"></script>
    <script src="~/js/persona-selector.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const institucionSelect =
                document.getElementById("institucionActuacion");

            const unidadSelect =
                document.getElementById("unidadActuacion");

            console.log("institucionSelect:", institucionSelect);
            console.log("unidadSelect:", unidadSelect);

            if (!institucionSelect || !unidadSelect) {
                console.error("No se encontraron los select de institución/unidad.");
                return;
            }

            institucionSelect.addEventListener("change", async function () {

                const institucionId = institucionSelect.value;

                console.log("Institución seleccionada:", institucionId);

                // Reiniciamos siempre el select dependiente.
                unidadSelect.innerHTML = "";
                unidadSelect.disabled = true;

                if (!institucionId) {
                    unidadSelect.innerHTML =
                        '<option value="">Seleccione primero una institución</option>';

                    return;
                }

                unidadSelect.innerHTML =
                    '<option value="">Cargando unidades...</option>';

                try {

                    const url =
                        '@Url.Action("UnidadesPorInstitucion", "Caso")'
                        + '?institucionId='
                        + encodeURIComponent(institucionId);

                    console.log("URL Fetch:", url);

                    const response = await fetch(url);

                    console.log("Status:", response.status);

                    if (!response.ok) {
                        throw new Error(
                            "HTTP " + response.status);
                    }

                    const unidades = await response.json();

                    console.log("Unidades recibidas:", unidades);

                    unidadSelect.innerHTML = "";

                    // La unidad es opcional.
                    const opcionVacia =
                        document.createElement("option");

                    opcionVacia.value = "";
                    opcionVacia.textContent = "Sin especificar";

                    unidadSelect.appendChild(opcionVacia);

                    unidades.forEach(function (unidad) {

                        const option =
                            document.createElement("option");

                        option.value = unidad.id;
                        option.textContent = unidad.nombre;

                        unidadSelect.appendChild(option);
                    });

                    // IMPORTANTE:
                    // se habilita después de obtener la respuesta.
                    unidadSelect.disabled = false;

                } catch (error) {

                    console.error(
                        "Error cargando unidades:",
                        error);

                    unidadSelect.innerHTML =
                        '<option value="">No se pudieron cargar las unidades</option>';

                    unidadSelect.disabled = true;
                }
            });
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const modal =
                document.getElementById("modalAgregarParticipante");

            const actuacionIdInput =
                document.getElementById("participanteActuacionId");

            const titulo =
                document.getElementById("participanteActuacionTitulo");

            const usuarioSelect =
                document.getElementById("participanteUsuarioId");

            if (!modal ||
                !actuacionIdInput ||
                !usuarioSelect) {
                return;
            }


            modal.addEventListener(
                "show.bs.modal",
                async function (event) {

                    /*
                     * Botón que provocó la apertura del modal.
                     */
                    const button = event.relatedTarget;

                    if (!button) {
                        return;
                    }

                    const actuacionId =
                        button.getAttribute("data-actuacion-id");

                    const actuacionTitulo =
                        button.getAttribute("data-actuacion-titulo");


                    // ==========================================
                    // ESTABLECER ACTUACIÓN
                    // ==========================================

                    actuacionIdInput.value =
                        actuacionId ?? "";

                    if (titulo) {
                        titulo.textContent =
                            actuacionTitulo ?? "";
                    }


                    // ==========================================
                    // ESTADO CARGANDO
                    // ==========================================

                    usuarioSelect.disabled = true;

                    usuarioSelect.innerHTML =
                        '<option value="">Cargando participantes...</option>';


                    if (!actuacionId) {
                        return;
                    }


                    try {

                        const url =
                            '@Url.Action(
                                                    "ParticipantesDisponibles",
                                                    "Caso")'
                            + '?actuacionId='
                            + encodeURIComponent(actuacionId);

                        const response =
                            await fetch(url);


                        if (!response.ok) {
                            throw new Error(
                                "No se pudieron cargar los participantes.");
                        }


                        const usuarios =
                            await response.json();


                        usuarioSelect.innerHTML = "";


                        // ======================================
                        // SIN USUARIOS
                        // ======================================

                        if (usuarios.length === 0) {

                            const option =
                                document.createElement("option");

                            option.value = "";
                            option.textContent =
                                "No hay profesionales disponibles";

                            usuarioSelect.appendChild(option);

                            usuarioSelect.disabled = true;

                            return;
                        }


                        // ======================================
                        // OPCIÓN INICIAL
                        // ======================================

                        const inicial =
                            document.createElement("option");

                        inicial.value = "";
                        inicial.textContent =
                            "Seleccione...";

                        usuarioSelect.appendChild(inicial);


                        // ======================================
                        // USUARIOS
                        // ======================================

                        usuarios.forEach(usuario => {

                            const option =
                                document.createElement("option");

                            option.value = usuario.id;

                            option.textContent =
                                usuario.unidadOrganizativa
                                    ? usuario.nombreCompleto +
                                    " — " +
                                    usuario.unidadOrganizativa
                                    : usuario.nombreCompleto;

                            usuarioSelect.appendChild(option);
                        });


                        usuarioSelect.disabled = false;

                    }
                    catch (error) {

                        console.error(error);

                        usuarioSelect.innerHTML =
                            '<option value="">Error al cargar profesionales</option>';

                        usuarioSelect.disabled = true;
                    }
                });
        });
    </script>
}