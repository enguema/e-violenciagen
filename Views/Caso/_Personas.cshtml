@model e_violenciagen.ViewModels.Casos.CasoDetailsViewModel

<div class="row g-4">

    <!-- VÍCTIMAS -->
    <div class="col-xl-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white py-3
                d-flex justify-content-between
                align-items-center">

                <h5 class="mb-0 fw-semibold">
                    Víctimas
                </h5>

                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal"
                        data-bs-target="#modalAgregarVictima">

                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                         class="bi bi-person-plus" viewBox="0 0 16 16">
                        <path
                        d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H1s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C9.516 10.68 8.289 10 6 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z" />
                        <path fill-rule="evenodd"
                              d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5" />
                    </svg>
                    Agregar víctima

                </button>

                <span class="badge bg-light text-dark">
                    @Model.Victimas.Count
                </span>

            </div>

            <div class="card-body">

                @if (!Model.Victimas.Any())
                {
                    <div class="text-center text-muted py-5">
                        No existen víctimas vinculadas.
                    </div>
                }
                else
                {
                    foreach (var persona in Model.Victimas)
                    {
                        <div class="border rounded-3 p-3 mb-3">

                            <div class="d-flex
                                justify-content-between
                                gap-3">

                                <div>

                                    <h6 class="fw-bold mb-1">
                                        @persona.NombreCompleto
                                    </h6>

                                    @if (!string.IsNullOrWhiteSpace(
                                        persona.NumeroDocumento))
                                    {
                                        <div class="small text-muted">
                                            @persona.TipoDocumento:
                                            @persona.NumeroDocumento
                                        </div>
                                    }

                                </div>

                                <div class="text-end">

                                    @if (persona.EsPrincipal)
                                    {
                                        <span class="badge bg-primary">
                                            Principal
                                        </span>
                                    }

                                    @if (persona.RequiereProteccion)
                                    {
                                        <span class="badge
                                            bg-warning-subtle
                                            text-warning-emphasis">
                                            Requiere protección
                                        </span>
                                    }

                                </div>

                                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal"
                                        data-bs-target="#desvincularVictima_@persona.PersonaId">

                                    Desvincular

                                </button>

                                @*Modal - Desvincular Víctima *@
                                <div class="modal fade" id="desvincularVictima_@persona.PersonaId" tabindex="-1"
                                     aria-hidden="true">

                                    <div class="modal-dialog modal-dialog-centered">

                                        <div class="modal-content">

                                            <form asp-controller="Caso" asp-action="DesvincularVictima" method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="CasoId" value="@Model.Id" />

                                                <input type="hidden" name="PersonaId" value="@persona.PersonaId" />

                                                <div class="modal-header">

                                                    <h5 class="modal-title">
                                                        Desvincular víctima
                                                    </h5>

                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                            aria-label="Cerrar">
                                                    </button>

                                                </div>

                                                <div class="modal-body">

                                                    <p>
                                                        ¿Desea desvincular a
                                                        <strong>@persona.NombreCompleto</strong>
                                                        de este expediente?
                                                    </p>

                                                    <div class="alert alert-warning mb-0">

                                                        Esta operación no eliminará a la persona
                                                        del sistema. Únicamente dejará de figurar
                                                        como víctima de este caso.

                                                    </div>

                                                </div>

                                                <div class="modal-footer">

                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">

                                                        Cancelar

                                                    </button>

                                                    <button type="submit" class="btn btn-danger">

                                                        Sí, desvincular

                                                    </button>

                                                </div>

                                            </form>

                                        </div>

                                    </div>

                                </div>


                            </div>

                        </div>
                    }
                }

            </div>
        </div>
    </div>


    <!-- PRESUNTOS AGRESORES -->
    <div class="col-xl-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white py-3
                d-flex justify-content-between
                align-items-center">

                <h5 class="mb-0 fw-semibold">
                    Presuntos agresores
                </h5>

                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal"
                        data-bs-target="#modalAgregarPresuntoAgresor">

                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                         class="bi bi-person-plus" viewBox="0 0 16 16">
                        <path
                        d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H1s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C9.516 10.68 8.289 10 6 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z" />
                        <path fill-rule="evenodd"
                              d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5" />
                    </svg>
                    Agregar Agresor

                </button>

                <span class="badge bg-light text-dark">
                    @Model.PresuntosAgresores.Count
                </span>

            </div>

            <div class="card-body">

                @if (!Model.PresuntosAgresores.Any())
                {
                    <div class="text-center text-muted py-5">
                        No existe presunto agresor identificado.
                    </div>
                }
                else
                {
                    foreach (var persona in Model.PresuntosAgresores)
                    {
                        <div class="d-flex justify-content-between gap-3">
                            <div class="border rounded-3 p-3 mb-3">
                                <h6 class="fw-bold mb-1">
                                    @persona.NombreCompleto
                                </h6>

                                @if (!string.IsNullOrWhiteSpace(
                                    persona.RelacionConVictima))
                                {
                                    <div class="small text-muted">
                                        Relación:
                                        @persona.RelacionConVictima
                                    </div>
                                }
                            </div>
                            

                            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal"
                                    data-bs-target="#desvincularAgresor_@persona.PersonaId">

                                Desvincular

                            </button>

                        </div>
                        

                        @*modal desvincular agresor*@
                        <div class="modal fade" id="desvincularAgresor_@persona.PersonaId" tabindex="-1" aria-hidden="true">

                            <div class="modal-dialog modal-dialog-centered">

                                <div class="modal-content">

                                    <form asp-controller="Caso" asp-action="DesvincularPresuntoAgresor" method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="CasoId" value="@Model.Id" />

                                        <input type="hidden" name="PersonaId" value="@persona.PersonaId" />

                                        <div class="modal-header">

                                            <h5 class="modal-title">
                                                Desvincular presunto agresor
                                            </h5>

                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar">
                                            </button>

                                        </div>

                                        <div class="modal-body">

                                            <p>
                                                ¿Desea desvincular a
                                                <strong>@persona.NombreCompleto</strong>
                                                de este expediente?
                                            </p>

                                            <div class="alert alert-warning mb-0">

                                                La persona permanecerá registrada en el
                                                sistema. Solo se eliminará su relación como
                                                presunto agresor de este caso.

                                            </div>

                                        </div>

                                        <div class="modal-footer">

                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">

                                                Cancelar

                                            </button>

                                            <button type="submit" class="btn btn-danger">

                                                Sí, desvincular

                                            </button>

                                        </div>

                                    </form>

                                </div>

                            </div>

                        </div>
                    }
                }

            </div>

        </div>
    </div>

</div>