<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - e_violenciagen</title>

    <script type="importmap"></script>

    <!-- DataTables -->
    <link rel="stylesheet"
          href="~/lib/datatables-bs5/dataTables.bootstrap5.min.css" />

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Estilos de la aplicación -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/e_violenciagen.styles.css"
          asp-append-version="true" />
</head>

<body>

    <div class="app-layout">

        <!-- ============================================
             SIDEBAR
             ============================================ -->
        <partial name="_Sidebar" />


        <!-- ============================================
             CONTENIDO PRINCIPAL
             ============================================ -->
        <div class="app-main">

            <!--
                Barra superior.
                En escritorio será muy discreta.
                En móvil contiene el botón para abrir el sidebar.
            -->
            <header class="app-topbar">

                <button type="button"
                        id="btnOpenSidebar"
                        class="btn btn-outline-secondary d-lg-none">

                    <span class="navbar-toggler-icon"></span>

                </button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-3">

                        <span class="text-muted">
                            @User.Identity.Name
                        </span>

                        <form asp-controller="Cuenta"
                            asp-action="Logout"
                            method="post"
                            class="m-0">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-secondary btn-sm">
                                Cerrar sesión
                            </button>

                        </form>

                    </div>
                }
                else
                {
                    <a asp-controller="Cuenta"
                    asp-action="Login"
                    class="btn btn-primary btn-sm">

                        Iniciar sesión

                    </a>
                }

            </header>


            <!-- ============================================
                 CONTENIDO DE LAS VISTAS
                 ============================================ -->
            <main role="main"
                  class="app-content">

                @RenderBody()

            </main>


            <!-- ============================================
                 FOOTER
                 ============================================ -->
            <footer class="app-footer">

                <div>
                    &copy; 2026 - e_violenciagen
                </div>

            </footer>

        </div>

    </div>


    <!-- ============================================
         SCRIPTS
         ============================================ -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/datatables/dataTables.min.js"></script>

    <script src="~/lib/datatables-bs5/dataTables.bootstrap5.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", required: false)

    @await RenderSectionAsync("Styles", required: false)

</body>

</html>