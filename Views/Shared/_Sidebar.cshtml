@{
    /*
        Obtenemos el controlador actual.

        Lo utilizamos para marcar automáticamente
        la opción activa del menú.
    */
    var controllerActual =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}


<aside id="appSidebar"
       class="app-sidebar">

    <!-- ============================================
         LOGO / NOMBRE DEL SISTEMA
         ============================================ -->
    <div class="sidebar-brand">

        <a asp-area=""
           asp-controller="Home"
           asp-action="Index"
           class="sidebar-brand-link">

            <div class="sidebar-logo">
                <strong>G</strong>
            </div>

            <span>e-ViolenciaGen</span>

        </a>


        <!--
            Botón visible solamente en móvil.
        -->
        <button type="button"
                id="btnCloseSidebar"
                class="btn btn-link text-white d-lg-none ms-auto p-0">

            <span class="fs-4">&times;</span>

        </button>

    </div>


    <div class="sidebar-divider"></div>


    <!-- ============================================
         MENÚ PRINCIPAL
         ============================================ -->
    <nav class="sidebar-menu">


        <!-- INICIO -->
        <a asp-area=""
           asp-controller="Home"
           asp-action="Index"
           class="sidebar-item
                  @(controllerActual == "Home" ? "active" : "")">

            <span class="sidebar-icon">
                ⌂
            </span>

            <span>Inicio</span>

        </a>


        <!-- PERSONAS -->
        <a asp-area=""
           asp-controller="Persona"
           asp-action="Index"
           class="sidebar-item
                  @(controllerActual == "Persona" ? "active" : "")">

            <span class="sidebar-icon">
                ♙
            </span>

            <span>Personas</span>

        </a>


        <!-- CASOS -->
        <a asp-area=""
           asp-controller="Caso"
           asp-action="Index"
           class="sidebar-item
                  @(controllerActual == "Caso" ? "active" : "")">

            <span class="sidebar-icon">
                ▣
            </span>

            <span>Casos</span>

        </a>


        <!-- EXPEDIENTES -->
        <a asp-area=""
           asp-controller="Expediente"
           asp-action="Index"
           class="sidebar-item
                  @(controllerActual == "Expediente" ? "active" : "")">

            <span class="sidebar-icon">
                ▤
            </span>

            <span>Expedientes</span>

        </a>


        <!-- ACTUACIONES -->
        <a asp-area=""
           asp-controller="Actuacion"
           asp-action="Index"
           class="sidebar-item
                  @(controllerActual == "Actuacion" ? "active" : "")">

            <span class="sidebar-icon">
                ✓
            </span>

            <span>Actuaciones</span>

        </a>

    </nav>


    <!-- ============================================
         ZONA DEL USUARIO
         ============================================ -->
    <div class="sidebar-user">

        <div class="sidebar-divider"></div>


        <div class="dropdown">

            <button type="button"
                    class="sidebar-user-button dropdown-toggle"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">

                <div class="sidebar-avatar">
                    U
                </div>

                <span>
                    @(User.Identity?.Name ?? "Usuario")
                </span>

            </button>


            <ul class="dropdown-menu dropdown-menu-dark">

                <li>
                    <a class="dropdown-item"
                       href="#">
                        Mi perfil
                    </a>
                </li>

                <li>
                    <hr class="dropdown-divider" />
                </li>

                <li>
                    <a class="dropdown-item"
                       href="#">
                        Cerrar sesión
                    </a>
                </li>

            </ul>

        </div>

    </div>

</aside>


<!--
    Fondo oscuro que aparece detrás del sidebar
    cuando se abre desde un móvil.
-->
<div id="sidebarBackdrop"
     class="sidebar-backdrop d-lg-none">
</div>