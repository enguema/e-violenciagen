@model e_violenciagen.ViewModels.Personas.PersonaFormViewModel

@{
    ViewData["Title"] = "Editar persona";
}


<div class="container-fluid py-4">

    @* =========================================================
       CABECERA
       ========================================================= *@

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Editar persona
            </h2>

            <p class="text-muted mb-0">
                Actualice los datos de la persona.
            </p>
        </div>

        <a asp-controller="Persona"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Volver

        </a>

    </div>


    @* =========================================================
       ALERTAS
       ========================================================= *@

    <div id="formAlert"
         class="alert d-none"
         role="alert">
    </div>


    @* =========================================================
       FORMULARIO
       ========================================================= *@

    <form id="personaForm"
          asp-controller="Persona"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input asp-for="Id"
               type="hidden" />


        <div class="row g-4">

            @* =================================================
               DATOS
               ================================================= *@

            <div class="col-lg-8">

                <partial name="_PersonaForm"
                         model="Model" />

            </div>


            @* =================================================
               FOTOGRAFÍA
               ================================================= *@

            <div class="col-lg-4">

                <div class="card border-0 shadow-sm">

                    <div class="card-header bg-white py-3">

                        <h5 class="mb-0">
                            <i class="bi bi-camera me-2"></i>
                            Fotografía
                        </h5>

                    </div>


                    <div class="card-body">


                        @* =====================================
                           FOTO ACTUAL
                           ===================================== *@

                        <div class="text-center mb-3">

                            @if (!string.IsNullOrWhiteSpace(
                                Model.RutaFotoActual))
                            {
                                <img id="photoPreview"
                                     src="@Model.RutaFotoActual"
                                     alt="Fotografía actual"
                                     class="img-fluid rounded border" />

                                <div id="photoPlaceholder"
                                     class="border rounded bg-light
                                            py-5 text-muted d-none">

                                    <i class="bi bi-person-circle
                                              fs-1 d-block mb-2">
                                    </i>

                                    Sin fotografía

                                </div>
                            }
                            else
                            {
                                <img id="photoPreview"
                                     alt="Vista previa"
                                     class="img-fluid rounded border d-none" />

                                <div id="photoPlaceholder"
                                     class="border rounded bg-light
                                            py-5 text-muted">

                                    <i class="bi bi-person-circle
                                              fs-1 d-block mb-2">
                                    </i>

                                    Sin fotografía

                                </div>
                            }

                        </div>


                        @* =====================================
                           NUEVA FOTO
                           ===================================== *@

                        <label asp-for="Foto"
                               class="form-label">
                            Nueva fotografía
                        </label>

                        <input asp-for="Foto"
                               id="fotoInput"
                               type="file"
                               class="form-control"
                               accept="image/jpeg,image/png,image/webp" />

                        <span asp-validation-for="Foto"
                              class="text-danger small">
                        </span>


                        <div class="form-text">
                            Si selecciona una imagen,
                            sustituirá la fotografía actual.
                        </div>


                        @* =====================================
                           ELIMINAR FOTO
                           ===================================== *@

                        @if (!string.IsNullOrWhiteSpace(
                            Model.RutaFotoActual))
                        {
                            <hr />

                            <div class="form-check">

                                <input asp-for="EliminarFoto"
                                       id="eliminarFoto"
                                       class="form-check-input" />

                                <label asp-for="EliminarFoto"
                                       class="form-check-label">

                                    Eliminar fotografía actual

                                </label>

                            </div>
                        }


                        <input asp-for="RutaFotoActual"
                               type="hidden" />

                    </div>

                </div>

            </div>

        </div>


        @* =====================================================
           BOTONES
           ===================================================== *@

        <div class="d-flex justify-content-end
                    gap-2 mt-4">

            <a asp-controller="Persona"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-outline-secondary">

                Cancelar

            </a>


            <button type="submit"
                    id="btnGuardar"
                    class="btn btn-primary">

                <span id="saveSpinner"
                      class="spinner-border
                             spinner-border-sm
                             me-2 d-none">
                </span>

                <i id="saveIcon"
                   class="bi bi-check-lg me-1">
                </i>

                Guardar cambios

            </button>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const form =
                    document.getElementById("personaForm");

                const fotoInput =
                    document.getElementById("fotoInput");

                const photoPreview =
                    document.getElementById("photoPreview");

                const photoPlaceholder =
                    document.getElementById("photoPlaceholder");

                const eliminarFoto =
                    document.getElementById("eliminarFoto");

                const btnGuardar =
                    document.getElementById("btnGuardar");

                const saveSpinner =
                    document.getElementById("saveSpinner");

                const saveIcon =
                    document.getElementById("saveIcon");

                const formAlert =
                    document.getElementById("formAlert");


                // =============================================
                // NUEVA FOTOGRAFÍA
                // =============================================

                fotoInput.addEventListener(
                    "change",
                    function () {

                        const file =
                            this.files?.[0];

                        if (!file) {
                            return;
                        }


                        /*
                         * Si el usuario selecciona una foto nueva,
                         * tiene más sentido cancelar la opción
                         * "Eliminar fotografía".
                         */
                        if (eliminarFoto) {
                            eliminarFoto.checked = false;
                        }


                        const objectUrl =
                            URL.createObjectURL(file);


                        photoPreview.src =
                            objectUrl;

                        photoPreview.classList.remove(
                            "d-none"
                        );

                        photoPlaceholder.classList.add(
                            "d-none"
                        );


                        photoPreview.onload =
                            function () {

                                URL.revokeObjectURL(
                                    objectUrl
                                );

                            };

                    });


                // =============================================
                // ELIMINAR FOTO
                // =============================================

                if (eliminarFoto) {

                    eliminarFoto.addEventListener(
                        "change",
                        function () {

                            if (!this.checked) {
                                return;
                            }


                            /*
                             * Si se marca eliminar fotografía,
                             * anulamos cualquier archivo nuevo
                             * previamente seleccionado.
                             */
                            fotoInput.value = "";


                            photoPreview.classList.add(
                                "d-none"
                            );

                            photoPlaceholder.classList.remove(
                                "d-none"
                            );

                        });

                }


                // =============================================
                // ENVÍO AJAX
                // =============================================

                form.addEventListener(
                    "submit",
                    async function (event) {

                        event.preventDefault();


                        if (
                            typeof $ !== "undefined" &&
                            $.validator &&
                            !$(form).valid()
                        ) {
                            return;
                        }


                        setSavingState(true);

                        hideAlert();


                        try {

                            const formData =
                                new FormData(form);


                            const response =
                                await fetch(
                                    form.action,
                                    {
                                        method: "POST",
                                        body: formData
                                    });


                            const result =
                                await response.json();


                            // =================================
                            // OK
                            // =================================

                            if (
                                response.ok &&
                                result.success
                            ) {

                                showAlert(
                                    result.message,
                                    "success"
                                );


                                setTimeout(
                                    function () {

                                        window.location.href =
                                            '@Url.Action(
                                                "Index",
                                                "Persona")';

                                    },
                                    900
                                );

                                return;
                            }


                            // =================================
                            // MODELSTATE
                            // =================================

                            if (
                                response.status === 400 &&
                                result.errors
                            ) {

                                showModelErrors(
                                    result.errors
                                );

                                showAlert(
                                    result.message ??
                                    "Revise los datos introducidos.",
                                    "warning"
                                );

                                return;
                            }


                            // =================================
                            // RESTO
                            // =================================

                            showAlert(
                                result.message ??
                                "No se pudieron guardar los cambios.",
                                "danger"
                            );

                        }
                        catch (error) {

                            console.error(
                                "Error actualizando Persona:",
                                error
                            );


                            showAlert(
                                "No se pudo comunicar con el servidor.",
                                "danger"
                            );

                        }
                        finally {

                            setSavingState(false);

                        }

                    });


                // =============================================
                // FUNCIONES
                // =============================================

                function setSavingState(saving) {

                    btnGuardar.disabled =
                        saving;

                    saveSpinner.classList.toggle(
                        "d-none",
                        !saving
                    );

                    saveIcon.classList.toggle(
                        "d-none",
                        saving
                    );

                }


                function showAlert(
                    message,
                    type
                ) {

                    formAlert.className =
                        `alert alert-${type}`;

                    formAlert.textContent =
                        message;

                    formAlert.classList.remove(
                        "d-none"
                    );


                    window.scrollTo({
                        top: 0,
                        behavior: "smooth"
                    });

                }


                function hideAlert() {

                    formAlert.classList.add(
                        "d-none"
                    );

                    formAlert.textContent =
                        "";

                }


                function showModelErrors(errors) {

                    Object.entries(errors)
                        .forEach(
                            ([key, messages]) => {

                                const input =
                                    form.elements[key];

                                if (!input) {
                                    return;
                                }


                                input.classList.add(
                                    "is-invalid"
                                );


                                const validationSpan =
                                    form.querySelector(
                                        `[data-valmsg-for="${key}"]`
                                    );


                                if (validationSpan) {

                                    validationSpan.textContent =
                                        messages[0] ?? "";

                                }

                            });

                }

            });

    </script>
}