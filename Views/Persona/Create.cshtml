@*@model e_violenciagen.ViewModels.Personas.PersonaCreateViewModel*@
@model e_violenciagen.ViewModels.Personas.PersonaFormViewModel
@{
    ViewData["Title"] = "Registrar persona";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Registrar persona
            </h2>

            <p class="text-muted mb-0">
                Introduzca los datos personales y de contacto.
            </p>
        </div>

        <a asp-controller="Persona"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Volver

        </a>

    </div>


    <div id="formAlert"
         class="alert d-none"
         role="alert">
    </div>


    <form id="personaForm"
          asp-controller="Persona"
          asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div class="row g-4">

            <div class="col-lg-8">

                <partial name="_PersonaForm"
                         model="Model" />

            </div>


            <div class="col-lg-4">

                <div class="card border-0 shadow-sm">

                    <div class="card-header bg-white py-3">

                        <h5 class="mb-0">
                            <i class="bi bi-camera me-2"></i>
                            Fotografía
                        </h5>

                    </div>


                    <div class="card-body">

                        <div class="text-center mb-3">

                            <div id="photoPlaceholder"
                                 class="border rounded bg-light
                                        py-5 text-muted">

                                <i class="bi bi-person-circle
                                          fs-1 d-block mb-2">
                                </i>

                                Sin fotografía

                            </div>


                            <img id="photoPreview"
                                 alt="Vista previa"
                                 class="img-fluid rounded border d-none" />

                        </div>


                        <label asp-for="Foto"
                               class="form-label">
                        </label>

                        <input asp-for="Foto"
                               id="fotoInput"
                               type="file"
                               class="form-control"
                               accept="image/jpeg,image/png,image/webp" />

                        <span asp-validation-for="Foto"
                              class="text-danger small">
                        </span>

                        <div class="form-text mt-2">
                            JPG, PNG o WEBP. Máximo 5 MB.
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end
                    gap-2 mt-4">

            <a asp-controller="Persona"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit"
                    id="btnGuardar"
                    class="btn btn-primary">

                <span id="saveSpinner"
                      class="spinner-border spinner-border-sm
                             me-2 d-none">
                </span>

                Guardar persona

            </button>

        </div>

    </form>

</div>