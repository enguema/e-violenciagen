@*@model e_violenciagen.ViewModels.Personas.PersonaCreateViewModel*@
@model e_violenciagen.ViewModels.Personas.PersonaFormViewModel
@{
    ViewData["Title"] = "Registrar persona";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Registrar persona
            </h2>

            <p class="text-muted mb-0">
                Introduzca los datos personales y de contacto.
            </p>
        </div>

        <a asp-controller="Persona"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Volver

        </a>

    </div>


    <div id="formAlert"
         class="alert d-none"
         role="alert">
    </div>


    <form id="personaForm"
          asp-controller="Persona"
          asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div class="row g-4">

            <div class="col-lg-8">

                <partial name="_PersonaForm"
                         model="Model" />

            </div>


            <div class="col-lg-4">

                <div class="card border-0 shadow-sm">

                    <div class="card-header bg-white py-3">

                        <h5 class="mb-0">
                            <i class="bi bi-camera me-2"></i>
                            Fotografía
                        </h5>

                    </div>


                    <div class="card-body">

                        <div class="text-center mb-3">

                            <div id="photoPlaceholder"
                                 class="border rounded bg-light
                                        py-5 text-muted">

                                <i class="bi bi-person-circle
                                          fs-1 d-block mb-2">
                                </i>

                                Sin fotografía

                            </div>


                            <img id="photoPreview"
                                 alt="Vista previa"
                                 class="img-fluid rounded border d-none" />

                        </div>


                        <label asp-for="Foto"
                               class="form-label">
                        </label>

                        <input asp-for="Foto"
                               id="fotoInput"
                               type="file"
                               class="form-control"
                               accept="image/jpeg,image/png,image/webp" />

                        <span asp-validation-for="Foto"
                              class="text-danger small">
                        </span>

                        <div class="form-text mt-2">
                            JPG, PNG o WEBP. Máximo 5 MB.
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end
                    gap-2 mt-4">

            <a asp-controller="Persona"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit"
                    id="btnGuardar"
                    class="btn btn-primary">

                <span id="saveSpinner"
                      class="spinner-border spinner-border-sm
                             me-2 d-none">
                </span>

                Guardar persona

            </button>

        </div>

    </form>

</div>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                // =============================================
                // ELEMENTOS DEL FORMULARIO
                // =============================================

                const form =
                    document.getElementById("personaForm");

                const fotoInput =
                    document.getElementById("fotoInput");

                const photoPreview =
                    document.getElementById("photoPreview");

                const photoPlaceholder =
                    document.getElementById("photoPlaceholder");

                const btnGuardar =
                    document.getElementById("btnGuardar");

                const saveSpinner =
                    document.getElementById("saveSpinner");

                const formAlert =
                    document.getElementById("formAlert");


                // =============================================
                // COMPROBACIÓN DE SEGURIDAD
                // =============================================

                if (!form) {

                    console.error(
                        "No se encontró el formulario personaForm."
                    );

                    return;
                }


                // =============================================
                // PREVISUALIZACIÓN DE FOTO
                // =============================================

                if (fotoInput &&
                    photoPreview &&
                    photoPlaceholder) {

                    fotoInput.addEventListener(
                        "change",
                        function () {

                            const file =
                                this.files?.[0];

                            if (!file) {

                                photoPreview.src = "";

                                photoPreview.classList.add(
                                    "d-none"
                                );

                                photoPlaceholder.classList.remove(
                                    "d-none"
                                );

                                return;
                            }


                            const objectUrl =
                                URL.createObjectURL(file);


                            photoPreview.src =
                                objectUrl;

                            photoPreview.classList.remove(
                                "d-none"
                            );

                            photoPlaceholder.classList.add(
                                "d-none"
                            );


                            photoPreview.onload =
                                function () {

                                    URL.revokeObjectURL(
                                        objectUrl
                                    );

                                };
                        });
                }


                // =============================================
                // ENVÍO DEL FORMULARIO
                // =============================================

                form.addEventListener(
                    "submit",
                    async function (event) {

                        /*
                         * MUY IMPORTANTE:
                         *
                         * Evita que el navegador haga el POST
                         * tradicional y muestre directamente
                         * el JSON del controlador.
                         */
                        event.preventDefault();


                        // =====================================
                        // VALIDACIÓN CLIENTE
                        // =====================================

                        if (
                            typeof $ !== "undefined" &&
                            $.validator &&
                            !$(form).valid()
                        ) {
                            return;
                        }


                        hideAlert();

                        setSavingState(true);


                        try {

                            /*
                             * FormData transporta también:
                             *
                             * - fotografía
                             * - AntiForgeryToken
                             * - resto de campos
                             */
                            const formData =
                                new FormData(form);


                            const response =
                                await fetch(
                                    form.action,
                                    {
                                        method: "POST",
                                        body: formData
                                    });


                            const result =
                                await response.json();


                            // =================================
                            // REGISTRO CORRECTO
                            // =================================

                            if (
                                response.ok &&
                                result.success
                            ) {

                                showAlert(
                                    result.message ??
                                    "La persona se ha registrado correctamente.",
                                    "success"
                                );


                                /*
                                 * Dejamos visible la confirmación
                                 * durante un instante y volvemos
                                 * al listado de Personas.
                                 */
                                setTimeout(
                                    function () {

                                        window.location.href =
                                            '@Url.Action(
                                                "Index",
                                                "Persona")';

                                    },
                                    900
                                );

                                return;
                            }


                            // =================================
                            // MODELSTATE
                            // =================================

                            if (
                                response.status === 400 &&
                                result.errors
                            ) {

                                showModelErrors(
                                    result.errors
                                );

                                showAlert(
                                    result.message ??
                                    "Revise los datos introducidos.",
                                    "warning"
                                );

                                return;
                            }


                            // =================================
                            // REGLA DE NEGOCIO / 422
                            // =================================

                            showAlert(
                                result.message ??
                                "No se pudo registrar la persona.",
                                "danger"
                            );

                        }
                        catch (error) {

                            console.error(
                                "Error registrando persona:",
                                error
                            );


                            showAlert(
                                "No se pudo comunicar con el servidor.",
                                "danger"
                            );

                        }
                        finally {

                            setSavingState(false);

                        }

                    });


                // =============================================
                // ESTADO DEL BOTÓN
                // =============================================

                function setSavingState(saving) {

                    if (!btnGuardar) {
                        return;
                    }

                    btnGuardar.disabled = saving;


                    if (saveSpinner) {

                        saveSpinner.classList.toggle(
                            "d-none",
                            !saving
                        );

                    }

                }


                // =============================================
                // ALERTAS
                // =============================================

                function showAlert(
                    message,
                    type
                ) {

                    if (!formAlert) {
                        return;
                    }


                    formAlert.className =
                        `alert alert-${type}`;

                    formAlert.textContent =
                        message;

                    formAlert.classList.remove(
                        "d-none"
                    );


                    window.scrollTo({
                        top: 0,
                        behavior: "smooth"
                    });

                }


                function hideAlert() {

                    if (!formAlert) {
                        return;
                    }

                    formAlert.classList.add(
                        "d-none"
                    );

                    formAlert.textContent = "";

                }


                // =============================================
                // ERRORES DE MODELSTATE
                // =============================================

                function showModelErrors(errors) {

                    Object.entries(errors)
                        .forEach(
                            ([key, messages]) => {

                                const input =
                                    form.elements[key];

                                if (!input) {
                                    return;
                                }


                                input.classList.add(
                                    "is-invalid"
                                );


                                const validationSpan =
                                    form.querySelector(
                                        `[data-valmsg-for="${key}"]`
                                    );


                                if (validationSpan) {

                                    validationSpan.textContent =
                                        messages[0] ?? "";

                                }

                            });

                }

            });

    </script>
}
