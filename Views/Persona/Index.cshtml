@{
    ViewData["Title"] = "Personas";
}

<div class="container-fluid py-4">

    @* =========================================================
       CABECERA
       ========================================================= *@

    <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center
                gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Gestión de Personas
            </h2>

            <p class="text-muted mb-0">
                Registro y administración de personas vinculadas
                al sistema.
            </p>
        </div>

        <div>
            <a asp-controller="Persona"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-person-plus me-1"></i>
                Nueva persona
            </a>
        </div>

    </div>


    @* =========================================================
       TARJETA PRINCIPAL
       ========================================================= *@

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-bottom py-3">

            <div class="d-flex align-items-center
                        justify-content-between">

                <div>
                    <h5 class="mb-1 fw-semibold">
                        Personas registradas
                    </h5>

                    <small class="text-muted">
                        Utilice el buscador para localizar una persona.
                    </small>
                </div>

            </div>

        </div>


        <div class="card-body">

            <div class="table-responsive">

                <table id="personasTable"
                       class="table table-hover
                              align-middle w-100">

                    <thead class="table-light">

                        <tr>

                            <th class="text-center">
                                Foto
                            </th>

                            <th>
                                Persona
                            </th>

                            <th>
                                Tipo documento
                            </th>

                            <th>
                                N.º documento
                            </th>

                            <th>
                                Teléfono
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Barrio
                            </th>

                            <th class="text-center">
                                Acciones
                            </th>

                        </tr>

                    </thead>

                    <tbody>
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


@section Styles
{
    <style>

        /* =====================================================
           TABLA
           ===================================================== */

        #personasTable thead th {
            white-space: nowrap;
            font-size: .875rem;
            font-weight: 600;
        }

        #personasTable tbody td {
            vertical-align: middle;
        }


        /* =====================================================
           FOTOGRAFÍA
           ===================================================== */

        .persona-photo {
            width: 46px;
            height: 46px;

            border-radius: 50%;

            object-fit: cover;

            border: 2px solid #e9ecef;
        }


        .persona-photo-placeholder {
            width: 46px;
            height: 46px;

            border-radius: 50%;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            background-color: #f1f3f5;

            font-size: 1.1rem;
            font-weight: 600;

            color: #6c757d;
        }


        /* =====================================================
           PERSONA
           ===================================================== */

        .persona-name {
            font-weight: 600;
        }


        /* =====================================================
           ACCIONES
           ===================================================== */

        .persona-actions {
            white-space: nowrap;
        }

        .persona-actions .btn {
            margin: 0 2px;
        }

    </style>
}



@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            // =================================================
            // URLS MVC
            // =================================================

            const dataTableUrl =
                '@Url.Action("DataTable", "Persona")';

            const detailsUrl =
                '@Url.Action("Details", "Persona")';

            const editUrl =
                '@Url.Action("Edit", "Persona")';


            // =================================================
            // DATATABLE
            // =================================================

            const table = $("#personasTable").DataTable({

                /*
                 * processing:
                 * DataTables muestra un indicador mientras
                 * espera la respuesta del servidor.
                 */
                processing: true,


                /*
                 * serverSide:
                 *
                 * Este es el punto fundamental.
                 *
                 * DataTables NO carga todas las personas.
                 * Cada página, búsqueda u ordenación provoca
                 * una nueva petición al servidor.
                 */
                serverSide: true,


                /*
                 * Evitamos disparar una petición por cada
                 * pulsación demasiado rápida del usuario.
                 */
                searchDelay: 450,


                // Página inicial.
                pageLength: 10,


                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],


                autoWidth: false,


                /*
                 * Orden inicial.
                 *
                 * Columna 1 = Persona.
                 *
                 * Debe coincidir con el mapeo establecido
                 * dentro de PersonaService.
                 */
                order: [[1, "asc"]],


                // =================================================
                // AJAX
                // =================================================

                ajax: {

                    url: dataTableUrl,

                    type: "POST",

                    /*
                     * DataTables enviará automáticamente:
                     *
                     * draw
                     * start
                     * length
                     * search[value]
                     * order[0][column]
                     * order[0][dir]
                     *
                     * que coinciden con nuestro
                     * DataTableRequest.
                     */
                    error: function (xhr) {

                        console.error(
                            "Error cargando Personas:",
                            xhr
                        );

                    }

                },


                // =================================================
                // COLUMNAS
                // =================================================

                columns: [

                    // =============================================
                    // 0 - FOTO
                    // =============================================

                    {
                        data: "rutaFoto",

                        orderable: false,

                        searchable: false,

                        className: "text-center",

                        width: "70px",

                        render: function (
                            data,
                            type,
                            row
                        ) {

                            /*
                             * Para operaciones internas de
                             * DataTables devolvemos únicamente
                             * el valor original.
                             */
                            if (type !== "display") {
                                return data ?? "";
                            }


                            if (data) {

                                return `
                                    <img
                                        src="${escapeHtml(data)}"
                                        alt="Fotografía"
                                        class="persona-photo"
                                        loading="lazy"
                                        onerror="this.style.display='none';
                                                 this.nextElementSibling.style.display='inline-flex';"
                                    />

                                    <span
                                        class="persona-photo-placeholder"
                                        style="display:none;">
                                        ${getInitials(row)}
                                    </span>
                                `;
                            }


                            return `
                                <span class="persona-photo-placeholder">
                                    ${getInitials(row)}
                                </span>
                            `;
                        }
                    },


                    // =============================================
                    // 1 - PERSONA
                    // =============================================

                    {
                        data: "nombreCompleto",

                        render: function (
                            data,
                            type,
                            row
                        ) {

                            if (type !== "display") {
                                return data ?? "";
                            }

                            return `
                                <div>
                                    <div class="persona-name">
                                        ${escapeHtml(
                                            data ?? ""
                                        )}
                                    </div>
                                </div>
                            `;
                        }
                    },


                    // =============================================
                    // 2 - TIPO DOCUMENTO
                    // =============================================

                    {
                        data: "tipoDocumento",

                        render: function (data) {

                            return data
                                ? escapeHtml(data)
                                : `<span class="text-muted">
                                       No indicado
                                   </span>`;
                        }
                    },


                    // =============================================
                    // 3 - NÚMERO DOCUMENTO
                    // =============================================

                    {
                        data: "numeroDocumento",

                        render: function (data) {

                            return data
                                ? escapeHtml(data)
                                : `<span class="text-muted">
                                       —
                                   </span>`;
                        }
                    },


                    // =============================================
                    // 4 - TELÉFONO
                    // =============================================

                    {
                        data: "telefono",

                        render: function (data) {

                            return data
                                ? escapeHtml(data)
                                : `<span class="text-muted">
                                       —
                                   </span>`;
                        }
                    },


                    // =============================================
                    // 5 - EMAIL
                    // =============================================

                    {
                        data: "email",

                        render: function (data) {

                            return data
                                ? escapeHtml(data)
                                : `<span class="text-muted">
                                       —
                                   </span>`;
                        }
                    },


                    // =============================================
                    // 6 - BARRIO
                    // =============================================

                    {
                        data: "barrio",

                        render: function (data) {

                            return data
                                ? escapeHtml(data)
                                : `<span class="text-muted">
                                       No indicado
                                   </span>`;
                        }
                    },


                    // =============================================
                    // 7 - ACCIONES
                    // =============================================

                    {
                        data: "id",

                        orderable: false,

                        searchable: false,

                        className:
                            "text-center persona-actions",

                        width: "130px",

                        render: function (
                            id,
                            type
                        ) {

                            if (type !== "display") {
                                return id;
                            }

                            const safeId =
                                encodeURIComponent(id);


                            return `
                                <a
                                    href="${detailsUrl}/${safeId}"
                                    class="btn btn-sm
                                           btn-outline-primary"
                                    title="Ver detalles">

                                    <i class="bi bi-eye"></i>

                                </a>

                                <a
                                    href="${editUrl}/${safeId}"
                                    class="btn btn-sm
                                           btn-outline-secondary"
                                    title="Editar">

                                    <i class="bi bi-pencil"></i>

                                </a>
                            `;
                        }
                    }
                ],


                // =================================================
                // IDIOMA
                // =================================================

                language: {

                    processing:
                        "Cargando personas...",

                    search:
                        "Buscar:",

                    lengthMenu:
                        "Mostrar _MENU_ registros",

                    info:
                        "Mostrando _START_ a _END_ de _TOTAL_ personas",

                    infoEmpty:
                        "No hay personas para mostrar",

                    infoFiltered:
                        "(filtrado de _MAX_ registros totales)",

                    zeroRecords:
                        "No se encontraron personas",

                    emptyTable:
                        "No existen personas registradas",

                    paginate: {
                        first: "Primero",
                        previous: "Anterior",
                        next: "Siguiente",
                        last: "Último"
                    }
                }

            });


            // =================================================
            // FUNCIONES AUXILIARES
            // =================================================

            /**
             * Escapa texto antes de introducirlo dentro
             * de HTML generado mediante JavaScript.
             *
             * Evita interpretar como HTML valores
             * procedentes de datos almacenados.
             */
            function escapeHtml(value) {

                if (value === null ||
                    value === undefined) {

                    return "";
                }

                return $("<div>")
                    .text(value)
                    .html();
            }


            /**
             * Genera unas iniciales para mostrar cuando
             * una persona no tenga fotografía.
             *
             * Ejemplo:
             *
             * Juan Nguema -> JN
             */
            function getInitials(persona) {

                const firstName =
                    persona.nombres?.trim()?.charAt(0)
                    ?? "";

                const lastName =
                    persona.apellidos?.trim()?.charAt(0)
                    ?? "";

                const initials =
                    `${firstName}${lastName}`
                        .toUpperCase();

                return escapeHtml(
                    initials || "?"
                );
            }

        });

    </script>
}