@using Microsoft.AspNetCore.Authorization
@*@using e_violenciagen.Security*@

@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Usuarios";


    var puedeCrear =
        await AuthorizationService.AuthorizeAsync(
            User,
            PermisosSistema.Seguridad.UsuariosCrear);


    var puedeEditar =
        await AuthorizationService.AuthorizeAsync(
            User,
            PermisosSistema.Seguridad.UsuariosEditar);


    var puedeCambiarEstado =
        await AuthorizationService.AuthorizeAsync(
            User,
            PermisosSistema.Seguridad.UsuariosCambiarEstado);
}


<div class="container-fluid">

    @* =========================================================
       CABECERA
       ========================================================= *@

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">
                Usuarios
            </h1>

            <p class="text-muted mb-0">
                Administración de usuarios del sistema.
            </p>
        </div>


        @if (puedeCrear.Succeeded)
        {
            <a asp-controller="Usuario"
               asp-action="Create"
               class="btn btn-primary">

                Nuevo usuario

            </a>
        }

    </div>


    @* =========================================================
       MENSAJES
       ========================================================= *@

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }


    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    @* =========================================================
       TABLA
       ========================================================= *@

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table id="usuariosTable"
                       class="table table-hover align-middle w-100">

                    <thead>

                        <tr>
                            <th>Usuario</th>

                            <th>Nombre completo</th>

                            <th>Institución</th>

                            <th>Roles</th>

                            <th>Estado</th>

                            <th>Último acceso</th>

                            <th class="text-end">
                                Acciones
                            </th>
                        </tr>

                    </thead>

                    <tbody>
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        $(document).ready(function () {

            $('#usuariosTable').DataTable({

                processing: true,

                serverSide: true,

                ajax: {
                    url: '@Url.Action("DataTable", "Usuario")',
                    type: 'POST'
                },


                columns: [

                    // ==========================================
                    // USUARIO
                    // ==========================================

                    {
                        data: 'nombreUsuario'
                    },


                    // ==========================================
                    // NOMBRE
                    // ==========================================

                    {
                        data: 'nombreCompleto'
                    },


                    // ==========================================
                    // INSTITUCIÓN
                    // ==========================================

                    {
                        data: null,

                        render: function (data) {

                            let html =
                                data.institucion ?? '';

                            if (data.unidadOrganizativa) {

                                html +=
                                    `<div class="small text-muted">
                                        ${data.unidadOrganizativa}
                                     </div>`;
                            }

                            return html;
                        }
                    },


                    // ==========================================
                    // ROLES
                    // ==========================================

                    {
                        data: 'roles',

                        render: function (data) {

                            return data || '-';
                        }
                    },


                    // ==========================================
                    // ESTADO
                    // ==========================================

                    {
                        data: null,

                        orderable: false,

                        render: function (data) {

                            let html = '';

                            if (data.activo) {

                                html +=
                                    '<span class="badge text-bg-success">Activo</span>';
                            }
                            else {

                                html +=
                                    '<span class="badge text-bg-secondary">Inactivo</span>';
                            }


                            if (data.bloqueado) {

                                html +=
                                    ' <span class="badge text-bg-warning">Bloqueado</span>';
                            }


                            return html;
                        }
                    },


                    // ==========================================
                    // ÚLTIMO ACCESO
                    // ==========================================

                    {
                        data: 'ultimoAcceso',

                        render: function (data) {

                            if (!data) {
                                return 'Nunca';
                            }

                            return new Date(data)
                                .toLocaleString();
                        }
                    },


                    // ==========================================
                    // ACCIONES
                    // ==========================================

                    {
                        data: 'id',

                        searchable: false,

                        orderable: false,

                        className: 'text-end',

                        render: function (id) {

                            let html = '';


                            /*
                             * Details siempre está disponible
                             * porque si llegó al Index ya tiene
                             * USUARIOS_VER.
                             */
                            html +=
                                `<a href="/Usuario/Details/${id}"
                                    class="btn btn-sm btn-outline-secondary me-1">
                                    Ver
                                 </a>`;


                            @if (puedeEditar.Succeeded)
                            {
                                <text>

                                html +=
                                    `<a href="/Usuario/Edit/${id}"
                                        class="btn btn-sm btn-outline-primary me-1">
                                        Editar
                                     </a>`;

                                </text>
                            }


                            return html;
                        }
                    }
                ],


                pageLength: 10,


                language: {

                    processing:
                        'Cargando usuarios...',

                    search:
                        'Buscar:',

                    lengthMenu:
                        'Mostrar _MENU_ registros',

                    info:
                        'Mostrando _START_ a _END_ de _TOTAL_ usuarios',

                    infoEmpty:
                        'No hay usuarios registrados',

                    zeroRecords:
                        'No se encontraron usuarios',

                    paginate: {
                        first: 'Primero',
                        last: 'Último',
                        next: 'Siguiente',
                        previous: 'Anterior'
                    }
                }

            });

        });

    </script>
}