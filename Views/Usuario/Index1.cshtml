@using Microsoft.AspNetCore.Authorization
@*@using e_violenciagen.Security*@

@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Usuarios";


    var puedeCrear =
        await AuthorizationService.AuthorizeAsync(
            User,
            PermisosSistema.Seguridad.UsuariosCrear);


    var puedeEditar =
        await AuthorizationService.AuthorizeAsync(
            User,
            PermisosSistema.Seguridad.UsuariosEditar);


    var puedeCambiarEstado =
        await AuthorizationService.AuthorizeAsync(
            User,
            PermisosSistema.Seguridad.UsuariosCambiarEstado);


    var puedeResetPassword =
        await AuthorizationService.AuthorizeAsync(
            User,
            PermisosSistema.Seguridad.UsuariosResetPassword);
}


<div class="container-fluid">

    @* =========================================================
       CABECERA
       ========================================================= *@

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">
                Usuarios
            </h1>

            <p class="text-muted mb-0">
                Administración de usuarios del sistema.
            </p>
        </div>

        <a asp-controller="Usuario" asp-action="Create" class="btn btn-primary">

            Nuevo usuario

        </a>
        @*@if (puedeCrear.Succeeded)
        {
            <a asp-controller="Usuario" asp-action="Create" class="btn btn-primary">

                Nuevo usuario

            </a>
        }*@

    </div>


    @* =========================================================
       MENSAJES
       ========================================================= *@
    <div id="usuarioAlertContainer"></div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }


    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    @* =========================================================
       TABLA
       ========================================================= *@
    <div class="alert alert-info">

        <div>
            UsuariosEditar:
            <strong>@puedeEditar.Succeeded</strong>
        </div>

        <div>
            UsuariosCambiarEstado:
            <strong>@puedeCambiarEstado.Succeeded</strong>
        </div>

        <div>
            UsuariosResetPassword:
            <strong>@puedeResetPassword.Succeeded</strong>
        </div>

    </div>
    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table id="usuariosTable" class="table table-hover align-middle w-100">

                    <thead>

                        <tr>
                            <th>Usuario</th>

                            <th>Nombre completo</th>

                            <th>Institución</th>

                            <th>Roles</th>

                            <th>Estado</th>

                            <th>Último acceso</th>

                            <th class="text-end">
                                Acciones
                            </th>
                        </tr>

                    </thead>

                    <tbody>
                    </tbody>

                </table>

                @* ============================================================
                    MODAL ACTIVAR / DESACTIVAR USUARIO
                    ============================================================ *@

                <div class="modal fade" id="estadoUsuarioModal" tabindex="-1" aria-labelledby="estadoUsuarioModalLabel"
                     aria-hidden="true">

                    <div class="modal-dialog modal-dialog-centered">

                        <div class="modal-content">

                            <form asp-controller="Usuario" asp-action="CambiarEstado" method="post"
                                  id="estadoUsuarioForm">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="id" id="estadoUsuarioId" />

                                <div class="modal-header">
                                    <h5 class="modal-title" id="estadoUsuarioModalLabel">
                                        Cambiar estado
                                    </h5>

                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar">
                                    </button>
                                </div>


                                <div class="modal-body">
                                    <div id="estadoUsuarioError" class="alert alert-danger d-none">
                                    </div>

                                    <p class="mb-0" id="estadoUsuarioMensaje">
                                    </p>
                                </div>


                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                        Cancelar
                                    </button>

                                    <button type="submit" id="estadoUsuarioConfirmar" class="btn btn-danger">
                                        Confirmar
                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>

                </div>

                @* ============================================================
   MODAL RESTABLECER CONTRASEÑA
   ============================================================ *@

                <div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel"
                     aria-hidden="true">

                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <form asp-controller="Usuario" asp-action="ResetPassword" method="post"
                                  id="resetPasswordForm">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="UsuarioId" id="resetPasswordUsuarioId" />

                                <div class="modal-header">
                                    <h5 class="modal-title" id="resetPasswordModalLabel">
                                        Restablecer contraseña
                                    </h5>

                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar">
                                    </button>
                                </div>


                                <div class="modal-body">
                                    <div id="resetPasswordError" class="alert alert-danger d-none">
                                    </div>

                                    <div class="mb-3">
                                        <span class="text-muted">
                                            Usuario:
                                        </span>
                                        <strong id="resetPasswordUsuario">
                                        </strong>
                                    </div>

                                    <div class="mb-3">
                                        <label for="nuevaPassword" class="form-label">
                                            Nueva contraseña
                                        </label>
                                        <input type="password" name="NuevaPassword" id="nuevaPassword"
                                               class="form-control" autocomplete="new-password" required />
                                    </div>


                                    <div class="mb-3">
                                        <label for="confirmarPassword" class="form-label">
                                            Confirmar contraseña
                                        </label>
                                        <input type="password" name="ConfirmarPassword" id="confirmarPassword"
                                               class="form-control" autocomplete="new-password" required />
                                    </div>
                                </div>


                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                        Cancelar
                                    </button>

                                    <button type="submit" class="btn btn-primary" id="resetPasswordConfirmar">
                                        Restablecer contraseña
                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>


                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        $(document).ready(function () {

            $('#usuariosTable').DataTable({

                // =========== opciones  de tabla ======
                processing: true,
                serverSide: true,

                ajax: {
                    url: '@Url.Action("DataTable", "Usuario")',
                    type: 'POST'
                },

                columns: [
                    // ==========================================
                    // USUARIO
                    // ==========================================

                    {
                        data: 'nombreUsuario'
                    },

                    // ==========================================
                    // NOMBRE
                    // ==========================================

                    {
                        data: 'nombreCompleto'
                    },

                    // ==========================================
                    // INSTITUCIÓN
                    // ==========================================

                    {
                        data: null,
                        render: function (data) {
                            let html =
                                data.institucion ?? '';
                            if (data.unidadOrganizativa) {
                                html +=
                                    `<div class="small text-muted">
                                                                                           ${data.unidadOrganizativa}
                                                                                     </div>`;
                            }
                            return html;
                        }
                    },


                    // ==========================================
                    // ROLES
                    // ==========================================

                    {
                        data: 'roles',
                        render: function (data) {
                            return data || '-';
                        }
                    },


                    // ==========================================
                    // ESTADO
                    // ==========================================

                    {
                        data: null,
                        orderable: false,
                        render: function (data) {
                            let html = '';
                            if (data.activo) {
                                html += '<span class="badge text-bg-success">Activo</span>';
                            }
                            else {
                                html += '<span class="badge text-bg-secondary">Inactivo</span>';
                            }
                            if (data.bloqueado) {
                                html += ' <span class="badge text-bg-warning">Bloqueado</span>';
                            }

                            return html;
                        }
                    },


                    // ==========================================
                    // ÚLTIMO ACCESO
                    // ==========================================

                    {
                        data: 'ultimoAcceso',
                        render: function (data) {

                            if (!data) {
                                return 'Nunca';
                            }

                            return new Date(data)
                                .toLocaleString();
                        }
                    },


                    // ==========================================
                    // ACCIONES
                    // ==========================================
                    
                    {
                        data: null,
                        searchable: false,
                        orderable: false,
                        className: 'text-end',
                        render: function (data) {
                            let opciones = '';


                            // ==============================================
                            // EDITAR
                            // ==============================================

                            @if (puedeEditar.Succeeded)
                                {
                                    <text>
                                            opciones += `
                                            <li>
                                                    <a class="dropdown-item" href="/Usuario/Edit/${data.id}">
                                                            Editar
                                                    </a>
                                            </li>`;
                                    </text>
                            }


                                // ==============================================
                                // ACTIVAR / DESACTIVAR
                                // ==============================================

                                @if (puedeCambiarEstado.Succeeded)
                                {
                                    <text>
                                            opciones += `
                                            <li>
                                                    <button type="button" class="dropdown-item js-cambiar-estado">
                                                            ${data.activo ? 'Desactivar' : 'Activar'}
                                                    </button>
                                            </li>`;
                                    </text>
                            }


                                // ==============================================
                                // RESET PASSWORD
                                // ==============================================

                                @if (puedeResetPassword.Succeeded)
                                {
                                    <text>
                                            opciones += `
                                            <li>
                                                    <button type="button" class="dropdown-item js-reset-password">
                                                            Restablecer contraseña
                                                    </button>
                                            </li>`;
                                    </text>
                            }


                                                                        /*
                                                                         * Si por permisos no existe ninguna acción,
                                                                         * no mostramos el menú.
                                                                         */
                                                                        if (!opciones) {
                                return '';
                            }

                            return `
                                                                            <div class="dropdown">

                                                                                <button type="button"
                                                                                        class="btn btn-sm btn-light"
                                                                                        data-bs-toggle="dropdown"
                                                                                        data-bs-boundary="viewport"
                                                                                        aria-expanded="false"
                                                                                        aria-label="Acciones">

                                                                                    <span class="fs-5 lh-1">
                                                                                        &#8942;
                                                                                    </span>

                                                                                </button>

                                                                                <ul class="dropdown-menu dropdown-menu-end">
                                                                                    ${opciones}
                                                                                </ul>
                                                                            </div>`;
                        }
                    }
                ],


                pageLength: 10,

                language: {
                    processing: 'Cargando usuarios...',
                    search: 'Buscar:',
                    lengthMenu: 'Mostrar _MENU_ registros',
                    info: 'Mostrando _START_ a _END_ de _TOTAL_ usuarios',
                    infoEmpty: 'No hay usuarios registrados',
                    zeroRecords: 'No se encontraron usuarios',

                    paginate: {
                        first: 'Primero',
                        last: 'Último',
                        next: 'Siguiente',
                        previous: 'Anterior'
                    }
                }

            });

            // ===== fin opciones  de tabla =====

            $('#usuariosTable tbody').on(
                'click',
                '.js-cambiar-estado',
                function () {

                    /*
                     * Obtenemos directamente los datos de la fila
                     * desde DataTables.
                     *
                     * Así evitamos colocar nombres y otros datos
                     * potencialmente problemáticos en atributos HTML.
                     */
                    const row =
                        table.row(
                            $(this).closest('tr')
                        ).data();


                    document
                        .getElementById('estadoUsuarioId')
                        .value = row.id;


                    const titulo =
                        document.getElementById(
                            'estadoUsuarioModalLabel');


                    const mensaje =
                        document.getElementById(
                            'estadoUsuarioMensaje');


                    const boton =
                        document.getElementById(
                            'estadoUsuarioConfirmar');


                    const error =
                        document.getElementById(
                            'estadoUsuarioError');


                    error.classList.add('d-none');
                    error.textContent = '';


                    if (row.activo) {

                        titulo.textContent =
                            'Desactivar usuario';

                        mensaje.textContent =
                            `¿Desea desactivar al usuario "${row.nombreUsuario}"?`;

                        boton.textContent =
                            'Desactivar';

                        boton.className =
                            'btn btn-danger';
                    }
                    else {

                        titulo.textContent =
                            'Activar usuario';

                        mensaje.textContent =
                            `¿Desea activar al usuario "${row.nombreUsuario}"?`;

                        boton.textContent =
                            'Activar';

                        boton.className =
                            'btn btn-success';
                    }


                    const modal =
                        new bootstrap.Modal(
                            document.getElementById(
                                'estadoUsuarioModal'));

                    modal.show();
                });

            //===== Enviar cambio de estado por fetch =====
            document
                .getElementById('estadoUsuarioForm')
                .addEventListener(
                    'submit',
                    async function (event) {

                        event.preventDefault();
                        const form = this;

                        const boton =
                            document.getElementById(
                                'estadoUsuarioConfirmar');

                        const error =
                            document.getElementById(
                                'estadoUsuarioError');


                        boton.disabled = true;
                        error.classList.add('d-none');

                        try {

                            const response =
                                await fetch(
                                    form.action,
                                    {
                                        method: 'POST',

                                        /*
                                         * FormData incluye automáticamente
                                         * el __RequestVerificationToken.
                                         */
                                        body: new FormData(form)
                                    });


                            const result =
                                await response.json();


                            if (!response.ok ||
                                !result.success) {

                                throw new Error(
                                    result.message
                                    ?? 'No se pudo actualizar el usuario.');
                            }


                            // Cerrar modal.
                            bootstrap.Modal
                                .getInstance(
                                    document.getElementById(
                                        'estadoUsuarioModal'))
                                ?.hide();


                            /*
                             * Refrescamos solo los datos de DataTables.
                             *
                             * false mantiene la página actual.
                             */
                            table.ajax.reload(null, false);


                            mostrarAlerta(result.message, 'success');
                        }
                        catch (err) {
                            error.textContent = err.message;
                            error.classList.remove('d-none');
                        }
                        finally {
                            boton.disabled = false;
                        }
                    });
                
            //===== Abrir modal de restablecer contraseña =====
            $('#usuariosTable tbody').on(
                'click',
                '.js-reset-password',
                function () {

                    const row =
                        table.row(
                            $(this).closest('tr')
                        ).data();


                    document
                        .getElementById(
                            'resetPasswordUsuarioId')
                        .value = row.id;

                    document
                        .getElementById('resetPasswordUsuario')
                        .textContent =
                        row.nombreUsuario;


                    /*
                     * Limpiamos siempre los campos.
                     */
                    document
                        .getElementById('nuevaPassword')
                        .value = '';

                    document
                        .getElementById('confirmarPassword')
                        .value = '';

                    const error =
                        document.getElementById('resetPasswordError');

                    error.classList.add('d-none');
                    error.textContent = '';


                    const modal =
                        new bootstrap.Modal(
                            document.getElementById('resetPasswordModal'));

                    modal.show();
                });

            document
                .getElementById('resetPasswordForm')
                .addEventListener(
                    'submit',
                    async function (event) {

                        event.preventDefault();


                        const form = this;

                        const error =
                            document.getElementById(
                                'resetPasswordError');

                        const boton =
                            document.getElementById(
                                'resetPasswordConfirmar');


                        error.classList.add('d-none');


                        const password =
                            document.getElementById(
                                'nuevaPassword')
                                .value;


                        const confirmacion =
                            document.getElementById(
                                'confirmarPassword')
                                .value;


                        /*
                         * Validación rápida del navegador.
                         *
                         * El servidor vuelve a validar igualmente.
                         */
                        if (password !== confirmacion) {
                            error.textContent = 'Las contraseñas no coinciden.';
                            error.classList.remove('d-none');
                            return;
                        }


                        boton.disabled = true;

                        try {
                            const response =
                                await fetch(
                                    form.action,
                                    {
                                        method: 'POST',
                                        body: new FormData(form)
                                    });

                            const result = await response.json();

                            if (!response.ok || !result.success) {

                                throw new Error(
                                    result.message
                                    ?? 'No se pudo restablecer la contraseña.');
                            }

                            bootstrap.Modal
                                .getInstance(document.getElementById('resetPasswordModal'))
                                ?.hide();

                            mostrarAlerta(result.message, 'success');
                        }
                        catch (err) {

                            error.textContent = err.message;

                            error.classList.remove('d-none');
                        }
                        finally {
                            boton.disabled = false;
                        }
                    });


        });
    
        //Mostrar alerta de éxito o error
        function mostrarAlerta(mensaje, tipo) {

            const container = document.getElementById('usuarioAlertContainer');

            container.innerHTML = `
                        <div class="alert alert-${tipo}
                                    alert-dismissible fade show"
                             role="alert">

                            ${mensaje}

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Cerrar">
                            </button>

                        </div>`;
        }

    </script>
}